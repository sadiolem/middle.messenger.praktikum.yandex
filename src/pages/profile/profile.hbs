{{#> profile-layout}}
    <div class="profile">
        <div class="profile__title-wrapper">
            {{> title level=1 text=user.display_name}}
        </div>
        <div class="profile__section">
            {{> profile-field label="Почта" value=user.email viewOnly=true}}
            {{> profile-field label="Логин" value=user.login viewOnly=true}}
            {{> profile-field label="Имя" value=user.first_name viewOnly=true}}
            {{> profile-field label="Фамилия" value=user.second_name viewOnly=true}}
            {{> profile-field label="Имя в чате" value=user.display_name viewOnly=true}}
            {{> profile-field label="Телефон" value=user.phone viewOnly=true}}
        </div>
        <ul class="profile__section profile__actions">
            <li>{{> link href="/settings/edit" text="Изменить данные"}}</li>
            <li>{{> link href="/settings/password" text="Изменить пароль"}}</li>
            <li>{{> button text="Выйти" variant="text" danger=true}}</li>
        </ul>
    </div>

    {{#if isAvatarModalOpen}}
        {{#> modal title="Загрузите файл"}}
            <form class="avatar-form">
                <label class="avatar-form__file">
                    <input class="avatar-form__input" type="file" name="avatar" accept="image/*">
                    <span class="avatar-form__file-text">Выбрать файл на компьютере</span>
                </label>
                {{> button text="Поменять" type="submit"}}
            </form>
        {{/modal}}
    {{/if}}
{{/profile-layout}}
