{{#> profile-layout}}
    <form class="profile">
        <div class="profile__section">
            {{> profile-field label="Старый пароль" name="oldPassword" type="password" value=password.oldPassword}}
            {{> profile-field label="Новый пароль" name="newPassword" type="password" value=password.newPassword}}
            {{> profile-field label="Повторите новый пароль" name="newPassword_repeat" type="password" value=password.newPassword_repeat}}
        </div>
        <div class="profile__submit">
            {{> button text="Сохранить" type="submit"}}
        </div>
    </form>
{{/profile-layout}}
