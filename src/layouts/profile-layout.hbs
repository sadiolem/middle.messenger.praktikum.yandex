<div class="profile-layout">
    <aside class="profile-layout__aside">
        <a class="profile-layout__back" href="/messenger" aria-label="Назад к чатам">
            <span class="material-symbols-rounded">arrow_back</span>
        </a>
    </aside>
    <main class="profile-layout__content">
        <label class="profile-layout__avatar">
            {{> avatar src=user.avatar}}
            <span class="profile-layout__avatar-hint">Поменять аватар</span>
            <input class="profile-layout__avatar-input" type="file" name="avatar" accept="image/*">
        </label>
        {{> @partial-block}}
    </main>
</div>
