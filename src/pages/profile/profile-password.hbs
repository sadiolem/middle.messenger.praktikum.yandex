{{#> profile-layout}}
    <form class="profile">
        <div class="profile__section">
            {{> profile-field label="Старый пароль" name="old_password" type="password" }}
            {{> profile-field label="Новый пароль" name="new_password" type="password" }}
            {{> profile-field label="Повторите новый пароль" name="new_password_repeat" type="password" }}
        </div>
        <div class="profile__button-wrapper">
            {{> button text="Сохранить" type="submit"}}
        </div>
    </form>
{{/profile-layout}}
